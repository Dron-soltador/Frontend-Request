# URL base del microservicio de Pedidos (el que expone /auth/login y /auth/register).
# En desarrollo se deja vacio para usar el proxy de Vite (ver vite.config.ts).
# En produccion se define la URL publica del backend, por ejemplo https://api.droneexpress.test
VITE_API_BASE_URL=

# Destino del proxy de Vite en desarrollo.
# Local: http://localhost:3001   |   Docker: http://localhost:3001   |   Red de la facultad: http://192.168.220.131:3001
VITE_API_PROXY_TARGET=http://localhost:3001